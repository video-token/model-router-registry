{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.video-token.com/schema/provider.schema.json",
  "title": "Model Router Hub Provider Schema",
  "description": "Schema for AI model providers listed in the Model Router Hub public registry.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "id",
    "name",
    "website",
    "status",
    "protocols",
    "models"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2"
    },

    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Unique Provider ID used by Model Router Hub."
    },

    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },

    "description": {
      "type": "string",
      "maxLength": 500
    },

    "website": {
      "type": "string",
      "format": "uri"
    },

    "register_url": {
      "type": "string",
      "format": "uri"
    },

    "pricing_url": {
      "type": "string",
      "format": "uri"
    },

    "documentation_url": {
      "type": "string",
      "format": "uri"
    },

    "status": {
      "type": "string",
      "enum": [
        "active",
        "beta",
        "maintenance",
        "inactive"
      ]
    },

    "company_region": {
      "type": "string",
      "description": "Provider-declared operating or registration region. Optional when unknown."
    },

    "api_regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "mainland_accessible": {
      "type": "boolean",
      "description": "Provider-declared Mainland China accessibility. Independent benchmark data is maintained separately."
    },

    "proxy_required": {
      "type": "boolean",
      "description": "Whether the Provider declares that a proxy is normally required."
    },

    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "openai-compatible",
          "anthropic-compatible",
          "gemini-compatible",
          "custom"
        ]
      }
    },

    "auth": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "type"
      ],

      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "bearer",
            "x-api-key",
            "custom-header",
            "query",
            "none"
          ]
        },

        "header_name": {
          "type": "string"
        }
      }
    },

    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "name",
          "base_url",
          "protocol",
          "status"
        ],

        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },

          "base_url": {
            "type": "string",
            "format": "uri"
          },

          "region": {
            "type": "string"
          },

          "protocol": {
            "type": "string",
            "enum": [
              "openai-compatible",
              "anthropic-compatible",
              "gemini-compatible",
              "custom"
            ]
          },

          "status": {
            "type": "string",
            "enum": [
              "active",
              "beta",
              "maintenance",
              "inactive"
            ]
          }
        }
      }
    },

    "models": {
      "type": "array",
      "minItems": 1,

      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "canonical_id",
          "upstream_id",
          "capabilities"
        ],

        "properties": {
          "canonical_id": {
            "type": "string",
            "description": "Canonical Model Router Hub model ID."
          },

          "upstream_id": {
            "type": "string",
            "minLength": 1,
            "description": "Actual model identifier used by this Provider."
          },

          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,

            "items": {
              "type": "string",
              "enum": [
                "text-generation",
                "image-generation",
                "image-edit",
                "video-generation",
                "audio-generation",
                "speech-to-text",
                "text-to-speech",
                "embedding"
              ]
            }
          },

          "pricing": {
            "type": "array",

            "items": {
              "type": "object",
              "additionalProperties": false,

              "required": [
                "currency",
                "unit",
                "value",
                "availability"
              ],

              "properties": {
                "currency": {
                  "type": "string",
                  "enum": [
                    "CNY",
                    "USD"
                  ]
                },

                "unit": {
                  "type": "string",
                  "enum": [
                    "request",
                    "image",
                    "second",
                    "minute",
                    "1m_input_tokens",
                    "1m_output_tokens",
                    "1m_tokens"
                  ]
                },

                "value": {
                  "type": "number",
                  "minimum": 0
                },

                "availability": {
                  "type": "string",
                  "enum": [
                    "available",
                    "unavailable",
                    "beta",
                    "unknown"
                  ]
                },

                "source_url": {
                  "type": "string",
                  "format": "uri"
                },

                "conditions": {
                  "type": "object",
                  "additionalProperties": false,

                  "properties": {
                    "resolution": {
                      "type": "string"
                    },

                    "quality": {
                      "type": "string"
                    },

                    "variant": {
                      "type": "string"
                    },

                    "duration_seconds": {
                      "type": "number",
                      "minimum": 0
                    },

                    "notes": {
                      "type": "string",
                      "maxLength": 300
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
