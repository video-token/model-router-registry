{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.video-token.com/schema/provider.schema.json",
  "title": "Model Router Hub Provider Schema",
  "description": "Schema for providers listed in the Model Router Hub public registry.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "id",
    "name",
    "website",
    "status",
    "company_region",
    "protocols",
    "models"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },

    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Unique provider identifier."
    },

    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },

    "description": {
      "type": "string",
      "maxLength": 500
    },

    "website": {
      "type": "string",
      "format": "uri"
    },

    "register_url": {
      "type": "string",
      "format": "uri"
    },

    "pricing_url": {
      "type": "string",
      "format": "uri"
    },

    "status": {
      "type": "string",
      "enum": [
        "active",
        "beta",
        "maintenance",
        "inactive"
      ]
    },

    "company_region": {
      "type": "string",
      "description": "Declared operating region of the provider."
    },

    "api_regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "mainland_accessible": {
      "type": "boolean"
    },

    "proxy_required": {
      "type": "boolean"
    },

    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "openai-compatible",
          "anthropic-compatible",
          "gemini-compatible",
          "custom"
        ]
      }
    },

    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "canonical_id",
          "upstream_id",
          "capabilities"
        ],

        "properties": {
          "canonical_id": {
            "type": "string"
          },

          "upstream_id": {
            "type": "string"
          },

          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "text",
                "image-generation",
                "image-edit",
                "video-generation",
                "audio",
                "embedding"
              ]
            }
          },

          "pricing": {
            "type": "object",
            "additionalProperties": false,

            "required": [
              "currency",
              "unit",
              "value"
            ],

            "properties": {
              "currency": {
                "type": "string",
                "enum": [
                  "CNY",
                  "USD"
                ]
              },

              "unit": {
                "type": "string",
                "enum": [
                  "request",
                  "image",
                  "second",
                  "minute",
                  "1m_input_tokens",
                  "1m_output_tokens"
                ]
              },

              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
